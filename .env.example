# Connexion directe Supabase (pour migrations)
DATABASE_URL=postgresql://postgres:VOTRE_MOT_DE_PASSE@db.qufitubopokkluynhcoo.supabase.co:5432/postgres
DIRECT_DATABASE_URL=postgresql://postgres:VOTRE_MOT_DE_PASSE@db.qufitubopokkluynhcoo.supabase.co:5432/postgres

# Sur Render uniquement : Transaction Pooler IPv4 (port 6543)
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
# SESSION_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

JWT_SECRET=une_chaine_aleatoire_longue_et_secrete_min_64_chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# Chiffrement applicatif des messages (AES-256-GCM).
# Generer avec: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MESSAGE_ENCRYPTION_KEY=base64_32_octets_a_generer
# En production, le chiffrement est obligatoire par defaut.
MESSAGE_ENCRYPTION_REQUIRED=true

GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx
GOOGLE_CALLBACK_URL=https://fitnesssapi.onrender.com/auth/google/callback

GITHUB_CLIENT_ID=xxx
GITHUB_CLIENT_SECRET=xxx
GITHUB_CALLBACK_URL=https://fitnesssapi.onrender.com/auth/github/callback

ADMIN_USERNAME=admin
ADMIN_PASSWORD=un_mot_de_passe_admin_securise_12_caracteres_min
ADMIN_SESSION_SECRET=une_autre_chaine_aleatoire
# Compte panel lecture seule: dashboard, stats, utilisateurs masques et Swagger.
ADMIN_VISITOR_USERNAME=visiteur
ADMIN_VISITOR_PASSWORD=un_mot_de_passe_visiteur_securise_12_caracteres_min

PORT=3000
NODE_ENV=production
API_VERSION=1.0.0
FRONTEND_DEEPLINK=fitnessppro://auth

# Cloudflare R2 - photos de profil
CLOUDFLARE_R2_ENDPOINT=https://f201431ed7e0bef93ba5cef6c930fc33.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=access_key_id_r2
CLOUDFLARE_R2_SECRET_ACCESS_KEY=secret_access_key_r2
CLOUDFLARE_R2_BUCKET_NAME=nom_du_bucket
# URL publique du bucket: domaine custom ou URL r2.dev publique du bucket.
CLOUDFLARE_R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev

# Origines autorisees (comma-separated). Exemple:
# CORS_ORIGINS=https://ton-app.vercel.app,https://admin.ton-app.com
CORS_ORIGINS=

# Limite de taille pour body JSON/urlencoded
BODY_LIMIT=1mb

# Optionnel: Restreindre le panel admin a des IPs fixes (comma-separated)
# Exemple: ADMIN_IP_ALLOWLIST=123.45.67.89,98.76.54.32
ADMIN_IP_ALLOWLIST=78.242.235.10

# Rate limits (adaptes a Render/Supabase free)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=25

ERROR_REPORT_RATE_LIMIT_WINDOW_MS=600000
ERROR_REPORT_RATE_LIMIT_MAX=30

ADMIN_LOGIN_RATE_LIMIT_WINDOW_MS=900000
ADMIN_LOGIN_RATE_LIMIT_MAX=10

# Verrouillage anti brute-force pour login admin
ADMIN_LOCK_THRESHOLD=5
ADMIN_LOCK_MS=900000

# Retention des logs securite (purge automatique)
LOG_RETENTION_DAYS=90
LOG_CLEANUP_INTERVAL_HOURS=24
# Par defaut: true en production, false en development.
# Mettre true en local seulement si la base Supabase est joignable.
LOG_CLEANUP_ENABLED=false

# Purge definitive des comptes desactives dont la date planifiee est depassee
ACCOUNT_CLEANUP_INTERVAL_HOURS=24
