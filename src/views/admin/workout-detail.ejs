<%
  var page = 'users';
  var title = 'Détail de la séance';

  function renderExercises(exerciseLogs) {
    if (exerciseLogs.length === 0) return '<p class="text-muted p-3 mb-0">Aucun exercice</p>';
    
    return exerciseLogs.map((ex, idx) => {
      let html = '<div class="border-bottom p-3" style="background: ' + (idx % 2 === 0 ? '#f8f9fa' : 'white') + ';">';
      html += '<div class="mb-3"><h6 class="mb-1"><strong>' + ex.exerciseName + '</strong></h6>';
      html += '<div class="d-flex gap-2 flex-wrap">';
      html += '<span class="badge bg-secondary">' + ex.exerciseType + '</span>';
      if (ex.exerciseId) html += '<span class="badge bg-light text-dark">ID: ' + ex.exerciseId + '</span>';
      if (ex.notes) html += '<span class="badge bg-info">📝 ' + ex.notes + '</span>';
      html += '</div></div>';

      // Sets
      if (ex.setLogs && ex.setLogs.length > 0) {
        html += '<div class="table-responsive"><table class="table table-sm mb-0">';
        html += '<thead class="table-light"><tr><th>Set</th><th>Reps</th><th>Poids (kg)</th><th>Statut</th><th>Repos (s)</th></tr></thead>';
        html += '<tbody>';
        ex.setLogs.forEach(set => {
          html += '<tr><td><strong>' + set.setNumber + '</strong></td><td>' + set.reps + '</td><td>' + set.weightKg.toFixed(1) + '</td>';
          html += '<td>' + (set.isCompleted ? '<span class="badge bg-success">✓ Complété</span>' : '<span class="badge bg-warning">✗ Incomplet</span>') + '</td>';
          html += '<td>' + (set.restTimeSec || '-') + '</td></tr>';
        });
        html += '</tbody></table></div>';
      }

      // Cardio
      if (ex.cardioLogs && ex.cardioLogs.length > 0) {
        html += '<div class="mt-3 p-2 bg-light rounded"><p class="text-muted small mb-2"><strong>🏃 Données cardio:</strong></p>';
        ex.cardioLogs.forEach(cardio => {
          html += '<div class="row g-2 small">';
          html += '<div class="col-6 col-md-3"><p class="text-muted mb-1">Durée</p><p class="mb-0"><strong>' + cardio.durationMinutes + ' min</strong></p></div>';
          html += '<div class="col-6 col-md-3"><p class="text-muted mb-1">Distance</p><p class="mb-0"><strong>' + cardio.distanceKm.toFixed(2) + ' km</strong></p></div>';
          html += '<div class="col-6 col-md-3"><p class="text-muted mb-1">Vitesse moy</p><p class="mb-0"><strong>' + cardio.avgSpeedKmh.toFixed(1) + ' km/h</strong></p></div>';
          html += '<div class="col-6 col-md-3"><p class="text-muted mb-1">Vitesse max</p><p class="mb-0"><strong>' + cardio.maxSpeedKmh.toFixed(1) + ' km/h</strong></p></div>';
          if (cardio.avgHeartRate) {
            html += '<div class="col-6 col-md-3"><p class="text-muted mb-1">HR moyen</p><p class="mb-0"><strong>' + cardio.avgHeartRate + ' bpm</strong></p></div>';
            html += '<div class="col-6 col-md-3"><p class="text-muted mb-1">HR max</p><p class="mb-0"><strong>' + cardio.maxHeartRate + ' bpm</strong></p></div>';
          }
          html += '</div>';
        });
        html += '</div>';
      }

      html += '</div>';
      return html;
    }).join('');
  }

  const exercisesHtml = renderExercises(workout.exerciseLogs);
%>
<%
var body = `
<a href="/admin/users/${workout.userId}" class="btn btn-outline-secondary btn-sm mb-3">← Profil utilisateur</a>

<div class="row">
  <div class="col-lg-8">
    <div class="card shadow-sm mb-3">
      <div class="card-header fw-semibold">🏋️ Infos de la séance</div>
      <div class="card-body">
        <div class="row g-3">
          <div class="col-md-6"><div class="border rounded p-3"><p class="text-muted small mb-1">Type</p><h6 class="mb-0">${workout.workoutType}</h6></div></div>
          <div class="col-md-6"><div class="border rounded p-3"><p class="text-muted small mb-1">Nom</p><h6 class="mb-0">${workout.name}</h6></div></div>
          <div class="col-md-6"><div class="border rounded p-3"><p class="text-muted small mb-1">Durée</p><h6 class="mb-0">${workout.durationMinutes} min</h6></div></div>
          <div class="col-md-6"><div class="border rounded p-3"><p class="text-muted small mb-1">Calories</p><h6 class="mb-0">${Math.round(workout.caloriesBurned)} kcal</h6></div></div>
          <div class="col-12"><div class="border rounded p-3"><p class="text-muted small mb-1">Dates et heures</p><p class="mb-1"><strong>Début:</strong> ${new Date(workout.startTime).toLocaleString('fr-FR')}</p><p class="mb-0"><strong>Fin:</strong> ${new Date(workout.endTime).toLocaleString('fr-FR')}</p></div></div>
          ${workout.notes ? '<div class="col-12"><div class="alert alert-info mb-0"><strong>Notes:</strong> ' + workout.notes + '</div></div>' : ''}
        </div>
      </div>
    </div>

    <div class="card shadow-sm mb-3">
      <div class="card-header fw-semibold">💪 Exercices (${workout.exerciseLogs.length})</div>
      <div class="card-body p-0">
        ${exercisesHtml}
      </div>
    </div>

    <div class="card shadow-sm">
      <div class="card-header fw-semibold">📊 Résumé</div>
      <div class="card-body">
        <div class="row g-3 text-center">
          <div class="col-md-4"><p class="text-muted small mb-1">Total des sets</p><h5 class="mb-0">${workout.exerciseLogs.reduce((sum, ex) => sum + (ex.setLogs ? ex.setLogs.length : 0), 0)}</h5></div>
          <div class="col-md-4"><p class="text-muted small mb-1">Poids total levé</p><h5 class="mb-0">${(() => { let total = 0; workout.exerciseLogs.forEach(ex => { if(ex.setLogs) ex.setLogs.forEach(set => total += set.weightKg * set.reps); }); return total > 0 ? total.toFixed(0) + ' kg' : '—'; })()}</h5></div>
          <div class="col-md-4"><p class="text-muted small mb-1">Exercices différents</p><h5 class="mb-0">${new Set(workout.exerciseLogs.map(ex => ex.exerciseName)).size}</h5></div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card shadow-sm mb-3">
      <div class="card-header fw-semibold">👤 Utilisateur</div>
      <div class="card-body">
        <p class="mb-2"><strong>${workout.user.name}</strong></p>
        <p class="text-muted small mb-0">${workout.user.email || '—'}</p>
        <hr>
        <a href="/admin/users/${workout.user.id}" class="btn btn-sm btn-outline-primary w-100">👁️ Voir le profil</a>
      </div>
    </div>

    <div class="card shadow-sm mb-3">
      <div class="card-header fw-semibold">ℹ️ Infos techniques</div>
      <div class="card-body small">
        <p class="text-muted mb-2"><strong>ID:</strong><br><code class="text-break">${workout.id}</code></p>
        <p class="text-muted mb-0"><strong>Créée le:</strong><br>${new Date(workout.createdAt).toLocaleString('fr-FR')}</p>
      </div>
    </div>

    <div class="card shadow-sm mb-3">
      <div class="card-header d-flex justify-content-between align-items-center" role="button" data-bs-toggle="collapse" data-bs-target="#apiJson" style="cursor: pointer;">
        <span class="fw-semibold">🔗 Réponse API JSON</span>
        <button type="button" class="btn btn-sm btn-outline-secondary" id="copyJsonBtn" onclick="copyJsonToClipboard(event)" style="display: none;">📋 Copier</button>
      </div>
      <div class="collapse" id="apiJson">
        <div class="card-body p-0">
          <pre id="jsonContainer" style="background: #1e1e1e; color: #d4d4d4; padding: 1rem; margin: 0; max-height: 500px; overflow-y: auto; font-size: 0.85rem; font-family: 'Courier New', Courier, monospace; border-radius: 0 0 0.25rem 0.25rem;"><code id="jsonContent"></code></pre>
        </div>
      </div>
    </div>

    <div class="card shadow-sm">
      <div class="card-header fw-semibold">⚙️ Actions</div>
      <div class="card-body">
        <a href="/admin/users/${workout.userId}/add-workout" class="btn btn-sm btn-primary w-100 mb-2">➕ Ajouter séance</a>
        <form method="POST" action="/admin/workouts/${workout.id}/delete" onsubmit="return confirm('Supprimer cette séance ?')" class="m-0">
          <button class="btn btn-sm btn-danger w-100" type="submit">🗑️ Supprimer</button>
        </form>
      </div>
    </div>
  </div>
</div>
`;
%>
<%- include('layout', { page, title, body, admin }) %>

<div id="jsonData" data-json='<%- JSON.stringify(JSON.stringify(workoutData)) %>' style="display:none;"></div>

<script>
// Afficher le JSON de la réponse API
const jsonData = JSON.parse(document.getElementById('jsonData').dataset.json);
const jsonString = JSON.stringify(JSON.parse(jsonData), null, 2);
document.getElementById('jsonContent').textContent = jsonString;
document.getElementById('copyJsonBtn').style.display = 'block';

function copyJsonToClipboard(e) {
  e.stopPropagation();
  const jsonText = document.getElementById('jsonContent').textContent;
  navigator.clipboard.writeText(jsonText).then(() => {
    const btn = document.getElementById('copyJsonBtn');
    const originalText = btn.innerHTML;
    btn.innerHTML = '✅ Copié!';
    setTimeout(() => {
      btn.innerHTML = originalText;
    }, 2000);
  }).catch(err => {
    alert('Erreur lors de la copie');
  });
}
</script>
