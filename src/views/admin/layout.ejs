<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>FitnessPro Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
    body { background: #f8f9fa; }
    .sidebar { min-height: 100vh; background: #212529; }
    .sidebar .nav-link { color: #adb5bd; }
    .sidebar .nav-link:hover, .sidebar .nav-link.active { color: #fff; background: #343a40; border-radius: 6px; }
    .sidebar .brand { color: #0d6efd; font-weight: 700; font-size: 1.2rem; }
    .main-content { padding: 2rem; }
    .stat-card { border-left: 4px solid #0d6efd; }
  </style>
</head>
<body>
<div class="container-fluid">
  <div class="row">
    <!-- Sidebar -->
    <nav class="col-md-2 sidebar px-3 py-4">
      <div class="brand mb-4 px-2"><i class="bi bi-activity"></i> FitnessPro</div>
      <ul class="nav flex-column gap-1">
        <li class="nav-item"><a class="nav-link <%= page==='dashboard'?'active':'' %>" href="/admin"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
        <li class="nav-item"><a class="nav-link <%= page==='versions'?'active':'' %>" href="/admin/versions"><i class="bi bi-phone me-2"></i>Versions</a></li>
        <li class="nav-item"><a class="nav-link <%= page==='users'?'active':'' %>" href="/admin/users"><i class="bi bi-people me-2"></i>Utilisateurs</a></li>
        <li class="nav-item"><a class="nav-link <%= page==='badges'?'active':'' %>" href="/admin/badges"><i class="bi bi-trophy me-2"></i>Badges</a></li>
        <li class="nav-item"><a class="nav-link <%= page==='stats'?'active':'' %>" href="/admin/stats"><i class="bi bi-bar-chart me-2"></i>Stats</a></li>
        <li class="nav-item"><a class="nav-link <%= page==='logs'?'active':'' %>" href="/admin/logs"><i class="bi bi-journal-text me-2"></i>Logs</a></li>
        <li class="nav-item"><a class="nav-link <%= page==='security-logs'?'active':'' %>" href="/admin/security-logs"><i class="bi bi-shield-lock me-2"></i>Security Logs</a></li>
        <li class="nav-item"><a class="nav-link <%= page==='error-reports'?'active':'' %>" href="/admin/error-reports"><i class="bi bi-kanban me-2"></i>Reports d'erreur</a></li>
        <li class="nav-item mt-4 border-top pt-3"><a class="nav-link text-primary" href="/api-docs" target="_blank"><i class="bi bi-book me-2"></i>API Swagger</a></li>
        <li class="nav-item">
          <form method="post" action="/admin/logout" class="m-0">
            <button type="submit" class="nav-link text-danger border-0 bg-transparent w-100 text-start">
              <i class="bi bi-box-arrow-right me-2"></i>Déconnexion
            </button>
          </form>
        </li>
      </ul>
    </nav>
    <!-- Main content -->
    <main class="col-md-10 main-content">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="mb-0"><%- title %></h4>
        <span class="text-muted small"><i class="bi bi-person-circle me-1"></i><%= admin %></span>
      </div>
      <%- body %>
    </main>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
