<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>FitnessPro Admin</title>
  <link rel="icon" href="/app_icon.svg" type="image/svg+xml">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
    :root {
      --admin-bg: #f4f6f8;
      --admin-surface: #ffffff;
      --admin-border: #dce3ea;
      --admin-muted: #64748b;
      --admin-text: #172033;
      --admin-sidebar: #101722;
      --admin-sidebar-hover: #1b2635;
    }

    body {
      background: var(--admin-bg);
      color: var(--admin-text);
      font-size: 0.95rem;
    }

    .admin-shell {
      min-height: 100vh;
    }

    .sidebar {
      min-height: 100vh;
      background: var(--admin-sidebar);
      position: sticky;
      top: 0;
      border-right: 1px solid rgba(255,255,255,0.08);
    }

    .sidebar .brand {
      color: #fff;
      font-weight: 800;
      font-size: 1.08rem;
      letter-spacing: 0;
      display: flex;
      align-items: center;
      gap: 0.65rem;
    }

    .brand-mark {
      width: 36px;
      height: 36px;
      display: block;
      background: #ff6b00;
      border-radius: 8px;
      box-shadow: 0 10px 25px rgba(37,99,235,0.28);
      object-fit: cover;
    }

    .sidebar .nav-link {
      color: #b6c2d2;
      border-radius: 8px;
      padding: 0.72rem 0.8rem;
      display: flex;
      align-items: center;
      min-height: 42px;
      font-weight: 600;
    }

    .sidebar .nav-link i {
      width: 1.25rem;
      text-align: center;
    }

    .sidebar .nav-link:hover,
    .sidebar .nav-link.active {
      color: #fff;
      background: var(--admin-sidebar-hover);
    }

    .sidebar .nav-link.active {
      box-shadow: inset 3px 0 0 #38bdf8;
    }

    .main-content {
      padding: 1.75rem;
    }

    .page-header {
      background: var(--admin-surface);
      border: 1px solid var(--admin-border);
      border-radius: 8px;
      padding: 1rem 1.15rem;
      box-shadow: 0 10px 30px rgba(15, 23, 42, 0.04);
    }

    .page-title {
      font-size: 1.35rem;
      font-weight: 800;
      letter-spacing: 0;
    }

    .admin-user-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      color: var(--admin-muted);
      background: #f8fafc;
      border: 1px solid var(--admin-border);
      border-radius: 999px;
      padding: 0.45rem 0.7rem;
    }

    .card {
      border-color: var(--admin-border);
      border-radius: 8px;
      box-shadow: 0 10px 30px rgba(15, 23, 42, 0.04);
    }

    .card-header {
      background: #fff;
      border-bottom-color: var(--admin-border);
    }

    .table {
      vertical-align: middle;
    }

    .table > :not(caption) > * > * {
      padding: 0.82rem 0.95rem;
    }

    .btn {
      border-radius: 7px;
      font-weight: 700;
    }

    .badge {
      border-radius: 999px;
      font-weight: 700;
      padding: 0.38em 0.62em;
    }

    .stat-card {
      border-left: 0;
      overflow: hidden;
    }

    .text-muted {
      color: var(--admin-muted) !important;
    }

    @media (max-width: 767.98px) {
      .sidebar {
        min-height: auto;
        position: relative;
      }

      .sidebar .nav {
        flex-direction: row !important;
        overflow-x: auto;
        padding-bottom: 0.25rem;
      }

      .sidebar .nav-item {
        flex: 0 0 auto;
      }

      .main-content {
        padding: 1rem;
      }

      .page-header {
        align-items: flex-start !important;
        gap: 0.75rem;
      }
    }
  </style>
</head>
<body>
<div class="container-fluid admin-shell">
  <div class="row">
    <nav class="col-md-2 sidebar px-3 py-4">
      <div class="brand mb-4 px-2"><img class="brand-mark" src="/app_icon.svg" alt="" width="36" height="36"> FitnessPro</div>
      <ul class="nav flex-column gap-1">
        <li class="nav-item"><a class="nav-link <%= page==='dashboard'?'active':'' %>" href="/admin"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
        <% if (!adminIsReadOnly) { %>
        <li class="nav-item"><a class="nav-link <%= page==='versions'?'active':'' %>" href="/admin/versions"><i class="bi bi-phone me-2"></i>Versions</a></li>
        <% } %>
        <li class="nav-item"><a class="nav-link <%= page==='users'?'active':'' %>" href="/admin/users"><i class="bi bi-people me-2"></i>Utilisateurs</a></li>
        <% if (!adminIsReadOnly) { %>
        <li class="nav-item"><a class="nav-link <%= page==='badges'?'active':'' %>" href="/admin/badges"><i class="bi bi-trophy me-2"></i>Badges</a></li>
        <% } %>
        <li class="nav-item"><a class="nav-link <%= page==='stats'?'active':'' %>" href="/admin/stats"><i class="bi bi-bar-chart me-2"></i>Stats</a></li>
        <% if (!adminIsReadOnly) { %>
        <li class="nav-item"><a class="nav-link <%= page==='logs'?'active':'' %>" href="/admin/logs"><i class="bi bi-journal-text me-2"></i>Logs</a></li>
        <li class="nav-item"><a class="nav-link <%= page==='security-logs'?'active':'' %>" href="/admin/security-logs"><i class="bi bi-shield-lock me-2"></i>Securite</a></li>
        <li class="nav-item"><a class="nav-link <%= page==='error-reports'?'active':'' %>" href="/admin/error-reports"><i class="bi bi-kanban me-2"></i>Erreurs</a></li>
        <% } %>
        <li class="nav-item mt-4 border-top border-secondary pt-3"><a class="nav-link text-primary" href="/api-docs" target="_blank"><i class="bi bi-book me-2"></i>API Swagger</a></li>
        <li class="nav-item">
          <form method="post" action="/admin/logout" class="m-0">
            <button type="submit" class="nav-link text-danger border-0 bg-transparent w-100 text-start">
              <i class="bi bi-box-arrow-right me-2"></i>Deconnexion
            </button>
          </form>
        </li>
      </ul>
    </nav>
    <main class="col-md-10 main-content">
      <div class="page-header d-flex justify-content-between align-items-center mb-4">
        <h1 class="page-title mb-0"><%- title %></h1>
        <span class="admin-user-pill small"><i class="bi bi-person-circle"></i><%= admin %><% if (adminIsReadOnly) { %> · visiteur<% } %></span>
      </div>
      <%- body %>
    </main>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
