<%
  var page = 'users';
  var title = 'Détail utilisateur';
%>
<%
var body = `
<a href="/admin/users" class="btn btn-outline-secondary btn-sm mb-3">← Retour</a>
<div class="row g-3">
  <div class="col-md-6">
    <div class="card shadow-sm">
      <div class="card-header fw-semibold">Profil</div>
      <div class="card-body">
        <table class="table table-sm mb-0">
          <tr><th>ID</th><td class="text-break">${user.id}</td></tr>
          <tr><th>Nom</th><td>${user.name}</td></tr>
          <tr><th>Email</th><td>${user.email || '—'}</td></tr>
          <tr><th>Âge</th><td>${user.age || '—'}</td></tr>
          <tr><th>Taille</th><td>${user.heightCm ? user.heightCm + ' cm' : '—'}</td></tr>
          <tr><th>Poids</th><td>${user.weightKg ? user.weightKg + ' kg' : '—'}</td></tr>
          <tr><th>Genre</th><td>${user.gender || '—'}</td></tr>
          <tr><th>Niveau</th><td>${user.fitnessLevel}</td></tr>
          <tr><th>Inscription</th><td>${new Date(user.createdAt).toLocaleString('fr-FR')}</td></tr>
          <tr><th>Statut</th><td>${user.isBanned ? '<span class="badge bg-danger">Banni</span>' : '<span class="badge bg-success">Actif</span>'}</td></tr>
        </table>
      </div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="card shadow-sm mb-3">
      <div class="card-header fw-semibold">Statistiques</div>
      <div class="card-body">
        <p>Séances muscu : <strong>${user._count.workouts}</strong></p>
        <p>Sessions course : <strong>${user._count.runningSessions}</strong></p>
        <p>Total séances : <strong>${user.totalWorkouts}</strong></p>
        <p>Streak actuel : <strong>${user.currentStreak}</strong></p>
        <p>Meilleur streak : <strong>${user.bestStreak}</strong></p>
      </div>
    </div>
    <div class="card shadow-sm">
      <div class="card-header fw-semibold">Badges (${user.userBadges.length})</div>
      <div class="card-body">
        ${user.userBadges.length === 0 ? '<p class="text-muted">Aucun badge</p>' :
          user.userBadges.map(b => `<span class="badge bg-warning text-dark me-1">${b.badgeId}</span>`).join('')}
      </div>
    </div>
  </div>
</div>
<div class="mt-3 d-flex gap-2">
  <form method="POST" action="/admin/users/${user.id}/ban">
    <button class="btn ${user.isBanned ? 'btn-success' : 'btn-warning'}" type="submit">
      ${user.isBanned ? 'Débannir' : 'Bannir'}
    </button>
  </form>
  <form method="POST" action="/admin/users/${user.id}/delete" onsubmit="return confirm('Supprimer définitivement ?')">
    <button class="btn btn-danger" type="submit">Supprimer le compte</button>
  </form>
</div>
`;
%>
<%- include('layout', { page, title, body, admin }) %>
