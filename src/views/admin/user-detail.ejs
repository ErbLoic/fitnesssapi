<%
  var page = 'users';
  var title = 'Détail utilisateur';
%>
<%
var body = `
<a href="/admin/users" class="btn btn-outline-secondary btn-sm mb-3">← Retour</a>
<div class="row g-3">
  <div class="col-md-6">
    <div class="card shadow-sm">
      <div class="card-header fw-semibold">👤 Profil</div>
      <div class="card-body">
        <table class="table table-sm mb-0">
          <tr><th>ID</th><td class="text-break text-muted small">${user.id}</td></tr>
          <tr><th>Nom</th><td>${user.name}</td></tr>
          <tr><th>Email</th><td>${user.email || '—'}</td></tr>
          <tr><th>Genre</th><td>${user.gender || '—'}</td></tr>
          <tr><th>Niveau</th><td>${user.fitnessLevel}</td></tr>
          <tr><th>OAuth</th><td>${user.oauthProviders.map(p => `<span class="badge bg-secondary me-1">${p.provider}</span>`).join('') || '—'}</td></tr>
          <tr><th>Inscription</th><td>${new Date(user.createdAt).toLocaleString('fr-FR')}</td></tr>
          <tr><th>Statut</th><td>${user.isBanned ? '<span class="badge bg-danger">Banni</span>' : '<span class="badge bg-success">Actif</span>'}</td></tr>
        </table>
      </div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="card shadow-sm mb-3">
      <div class="card-header fw-semibold">📊 Statistiques</div>
      <div class="card-body">
        <div class="row g-2 text-center">
          <div class="col-6">
            <div class="border rounded p-2">
              <div class="fs-4 fw-bold">${user._count.workouts}</div>
              <div class="text-muted small">Séances muscu</div>
            </div>
          </div>
          <div class="col-6">
            <div class="border rounded p-2">
              <div class="fs-4 fw-bold">${user._count.runningSessions}</div>
              <div class="text-muted small">Sessions course</div>
            </div>
          </div>
          <div class="col-6">
            <div class="border rounded p-2">
              <div class="fs-4 fw-bold">${friendCount}</div>
              <div class="text-muted small">Amis</div>
            </div>
          </div>
          <div class="col-6">
            <div class="border rounded p-2">
              <div class="fs-4 fw-bold">${convoCount}</div>
              <div class="text-muted small">Conversations</div>
            </div>
          </div>
          <div class="col-6">
            <div class="border rounded p-2">
              <div class="fs-4 fw-bold">${user.currentStreak}</div>
              <div class="text-muted small">Streak actuel</div>
            </div>
          </div>
          <div class="col-6">
            <div class="border rounded p-2">
              <div class="fs-4 fw-bold">${user.bestStreak}</div>
              <div class="text-muted small">Meilleur streak</div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="card shadow-sm">
      <div class="card-header fw-semibold">🏅 Badges (${user.userBadges.length})</div>
      <div class="card-body">
        ${user.userBadges.length === 0 ? '<p class="text-muted mb-0">Aucun badge</p>' :
          user.userBadges.map(b => `<span class="badge bg-warning text-dark me-1 mb-1">${b.badgeId}</span>`).join('')}
      </div>
    </div>
  </div>
</div>

<!-- Dernières séances -->
<div class="card shadow-sm mt-3">
  <div class="card-header d-flex justify-content-between align-items-center fw-semibold">
    <span>🏋️ Dernières séances (5)</span>
    <a href="/admin/users/${user.id}/add-workout" class="btn btn-sm btn-primary">➕ Ajouter une séance</a>
  </div>
  <div class="card-body p-0">
    <table class="table table-sm table-hover mb-0">
      <thead class="table-light">
        <tr><th>Nom</th><th>Type</th><th>Durée</th><th>Date</th><th>Action</th></tr>
      </thead>
      <tbody>
        ${recentWorkouts.map(w => `
        <tr>
          <td><a href="/admin/workouts/${w.id}" class="text-decoration-none">${w.name || '—'}</a></td>
          <td><span class="badge bg-secondary">${w.workoutType}</span></td>
          <td>${w.durationMinutes ? w.durationMinutes + ' min' : '—'}</td>
          <td class="text-muted small">${new Date(w.startTime).toLocaleString('fr-FR', { day:'2-digit', month:'2-digit', year:'2-digit', hour:'2-digit', minute:'2-digit' })}</td>
          <td>
            <form method="POST" action="/admin/workouts/${w.id}/delete" onsubmit="return confirm('Supprimer cette séance ?')" style="display:inline">
              <button class="btn btn-sm btn-outline-danger">Supprimer</button>
            </form>
          </td>
        </tr>`).join('')}
        ${recentWorkouts.length === 0 ? '<tr><td colspan="5" class="text-muted text-center py-3">Aucune séance</td></tr>' : ''}
      </tbody>
    </table>
  </div>
</div>

<!-- Dernières courses -->
<div class="card shadow-sm mt-3">
  <div class="card-header fw-semibold">🏃 Dernières courses (5)</div>
  <div class="card-body p-0">
    <table class="table table-sm table-hover mb-0">
      <thead class="table-light">
        <tr><th>Distance</th><th>Durée</th><th>Date</th><th>Action</th></tr>
      </thead>
      <tbody>
        ${recentRuns.map(r => `
        <tr>
          <td><a href="/admin/running/${r.id}" style="text-decoration: none; color: inherit;">${r.distanceKm ? r.distanceKm.toFixed(2) + ' km' : '—'}</a></td>
          <td>${r.durationSeconds ? Math.floor(r.durationSeconds / 60) + ' min' : '—'}</td>
          <td class="text-muted small">${new Date(r.startTime).toLocaleString('fr-FR', { day:'2-digit', month:'2-digit', year:'2-digit', hour:'2-digit', minute:'2-digit' })}</td>
          <td>
            <a href="/admin/running/${r.id}" class="btn btn-sm btn-outline-primary">Voir</a>
          </td>
        </tr>`).join('')}
        ${recentRuns.length === 0 ? '<tr><td colspan="4" class="text-muted text-center py-3">Aucune course</td></tr>' : ''}
      </tbody>
    </table>
  </div>
</div>

<div class="mt-3 d-flex gap-2">
  <form method="POST" action="/admin/users/${user.id}/ban">
    <button class="btn ${user.isBanned ? 'btn-success' : 'btn-warning'}" type="submit">
      ${user.isBanned ? '✅ Débannir' : '🚫 Bannir'}
    </button>
  </form>
  <form method="POST" action="/admin/users/${user.id}/delete" onsubmit="return confirm('Supprimer définitivement ce compte et toutes ses données ?')">
    <button class="btn btn-danger" type="submit">🗑️ Supprimer le compte</button>
  </form>
</div>
`;
%>
<%- include('layout', { page, title, body, admin }) %>
