<%
  var page = 'stats';
  var title = 'Statistiques globales';
%>
<%
var body = `
<div class="row g-3 mb-4">
  <div class="col-md-4 col-6">
    <div class="card shadow-sm stat-card">
      <div class="card-body">
        <div class="text-muted small">👥 Total utilisateurs</div>
        <div class="fs-2 fw-bold">${stats.totalUsers.toLocaleString()}</div>
        <div class="text-muted small">+${stats.newUsersWeek} cette semaine · +${stats.newUsersMonth} ce mois</div>
      </div>
    </div>
  </div>
  <div class="col-md-4 col-6">
    <div class="card shadow-sm" style="border-left:4px solid #198754">
      <div class="card-body">
        <div class="text-muted small">🏋️ Séances musculation</div>
        <div class="fs-2 fw-bold">${stats.totalWorkouts.toLocaleString()}</div>
        <div class="text-muted small">+${stats.workoutsWeek} cette semaine</div>
      </div>
    </div>
  </div>
  <div class="col-md-4 col-6">
    <div class="card shadow-sm" style="border-left:4px solid #fd7e14">
      <div class="card-body">
        <div class="text-muted small">🏃 Sessions course</div>
        <div class="fs-2 fw-bold">${stats.totalRuns.toLocaleString()}</div>
        <div class="text-muted small">${stats.totalDistanceKm} km parcourus</div>
      </div>
    </div>
  </div>
  <div class="col-md-4 col-6">
    <div class="card shadow-sm" style="border-left:4px solid #6f42c1">
      <div class="card-body">
        <div class="text-muted small">👟 Pas totaux</div>
        <div class="fs-2 fw-bold">${stats.totalSteps.toLocaleString()}</div>
      </div>
    </div>
  </div>
  <div class="col-md-4 col-6">
    <div class="card shadow-sm" style="border-left:4px solid #ffc107">
      <div class="card-body">
        <div class="text-muted small">🏅 Badges débloqués</div>
        <div class="fs-2 fw-bold">${stats.badgeCount.toLocaleString()}</div>
      </div>
    </div>
  </div>
  <div class="col-md-4 col-6">
    <div class="card shadow-sm" style="border-left:4px solid #0dcaf0">
      <div class="card-body">
        <div class="text-muted small">🤝 Amitiés actives</div>
        <div class="fs-2 fw-bold">${stats.friendshipCount.toLocaleString()}</div>
      </div>
    </div>
  </div>
  <div class="col-md-4 col-6">
    <div class="card shadow-sm" style="border-left:4px solid #20c997">
      <div class="card-body">
        <div class="text-muted small">💬 Conversations</div>
        <div class="fs-2 fw-bold">${stats.conversationCount.toLocaleString()}</div>
      </div>
    </div>
  </div>
</div>

<div class="row g-3 mb-4">
  <!-- Graphique inscriptions 7 jours -->
  <div class="col-md-6">
    <div class="card shadow-sm">
      <div class="card-header fw-semibold">📈 Inscriptions — 7 derniers jours</div>
      <div class="card-body">
        <div class="d-flex align-items-flex-end gap-2" style="height:120px">
          ${inscriptionsByDay.map(d => `
          <div class="d-flex flex-column align-items-center flex-grow-1">
            <div class="text-muted" style="font-size:.65rem">${d.count}</div>
            <div style="
              width:100%;
              height:${Math.max(4, Math.round(d.count / maxInscriptions * 90))}px;
              background:linear-gradient(180deg,#0d6efd,#6ea8fe);
              border-radius:4px 4px 0 0;
              transition:height .3s;
            "></div>
            <div class="text-muted mt-1" style="font-size:.6rem;white-space:nowrap">${d.date.slice(5)}</div>
          </div>`).join('')}
        </div>
      </div>
    </div>
  </div>

  <!-- Répartition types de séances -->
  <div class="col-md-6">
    <div class="card shadow-sm">
      <div class="card-header fw-semibold">🏋️ Répartition des séances</div>
      <div class="card-body">
        <div class="mb-3">
          <div class="d-flex justify-content-between mb-1">
            <span class="small">Force (strength)</span>
            <span class="small fw-bold">${typePercent.strength}%</span>
          </div>
          <div class="progress" style="height:8px">
            <div class="progress-bar bg-success" style="width:${typePercent.strength}%"></div>
          </div>
        </div>
        <div class="mb-3">
          <div class="d-flex justify-content-between mb-1">
            <span class="small">Cardio</span>
            <span class="small fw-bold">${typePercent.cardio}%</span>
          </div>
          <div class="progress" style="height:8px">
            <div class="progress-bar bg-warning" style="width:${typePercent.cardio}%"></div>
          </div>
        </div>
        <div>
          <div class="d-flex justify-content-between mb-1">
            <span class="small">Mixte</span>
            <span class="small fw-bold">${typePercent.mixed}%</span>
          </div>
          <div class="progress" style="height:8px">
            <div class="progress-bar bg-info" style="width:${typePercent.mixed}%"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Top 5 exercices -->
<div class="row g-3">
  <div class="col-md-6">
    <div class="card shadow-sm">
      <div class="card-header fw-semibold">💪 Top 5 exercices (plateforme)</div>
      <div class="card-body p-0">
        <table class="table table-sm mb-0">
          <thead class="table-light">
            <tr><th>#</th><th>Exercice</th><th>Occurrences</th></tr>
          </thead>
          <tbody>
            ${topExercises.map((e, i) => `
            <tr>
              <td class="text-muted">${i + 1}</td>
              <td>${e.name}</td>
              <td><span class="badge bg-primary">${e.count}</span></td>
            </tr>`).join('')}
            ${topExercises.length === 0 ? '<tr><td colspan="3" class="text-muted text-center py-3">Aucune donnée</td></tr>' : ''}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
`;
%>
<%- include('layout', { page, title, body, admin }) %>
