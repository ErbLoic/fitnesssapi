<%
  var page = 'stats';
  var title = 'Statistiques globales';
%>
<%
var body = `
<div class="row g-3 mb-4">
  <div class="col-md-4 col-6">
    <div class="card shadow-sm stat-card">
      <div class="card-body">
        <div class="text-muted small">👥 Total utilisateurs</div>
        <div class="fs-2 fw-bold">${stats.totalUsers.toLocaleString()}</div>
        <div class="text-muted small">+${stats.newUsersWeek} cette semaine · +${stats.newUsersMonth} ce mois</div>
      </div>
    </div>
  </div>
  <div class="col-md-4 col-6">
    <div class="card shadow-sm" style="border-left:4px solid #198754">
      <div class="card-body">
        <div class="text-muted small">🏋️ Séances musculation</div>
        <div class="fs-2 fw-bold">${stats.totalWorkouts.toLocaleString()}</div>
        <div class="text-muted small">+${stats.workoutsWeek} cette semaine</div>
      </div>
    </div>
  </div>
  <div class="col-md-4 col-6">
    <div class="card shadow-sm" style="border-left:4px solid #fd7e14">
      <div class="card-body">
        <div class="text-muted small">🏃 Sessions course</div>
        <div class="fs-2 fw-bold">${stats.totalRuns.toLocaleString()}</div>
        <div class="text-muted small">${stats.totalDistanceKm} km parcourus</div>
      </div>
    </div>
  </div>
  <div class="col-md-4 col-6">
    <div class="card shadow-sm" style="border-left:4px solid #6f42c1">
      <div class="card-body">
        <div class="text-muted small">👟 Pas totaux</div>
        <div class="fs-2 fw-bold">${stats.totalSteps.toLocaleString()}</div>
      </div>
    </div>
  </div>
  <div class="col-md-4 col-6">
    <div class="card shadow-sm" style="border-left:4px solid #ffc107">
      <div class="card-body">
        <div class="text-muted small">🏅 Badges débloqués</div>
        <div class="fs-2 fw-bold">${stats.badgeCount.toLocaleString()}</div>
      </div>
    </div>
  </div>
  <div class="col-md-4 col-6">
    <div class="card shadow-sm" style="border-left:4px solid #0dcaf0">
      <div class="card-body">
        <div class="text-muted small">🤝 Amitiés actives</div>
        <div class="fs-2 fw-bold">${stats.friendshipCount.toLocaleString()}</div>
      </div>
    </div>
  </div>
  <div class="col-md-4 col-6">
    <div class="card shadow-sm" style="border-left:4px solid #20c997">
      <div class="card-body">
        <div class="text-muted small">💬 Conversations</div>
        <div class="fs-2 fw-bold">${stats.conversationCount.toLocaleString()}</div>
      </div>
    </div>
  </div>
</div>

<div class="row g-3 mb-4">
  <!-- Graphique inscriptions 7 jours -->
  <div class="col-md-6">
    <div class="card shadow-sm">
      <div class="card-header fw-semibold">📈 Inscriptions — 7 derniers jours</div>
      <div class="card-body">
        <canvas id="inscriptionsChart" height="120"></canvas>
      </div>
    </div>
  </div>

  <!-- Répartition types de séances -->
  <div class="col-md-6">
    <div class="card shadow-sm">
      <div class="card-header fw-semibold">🏋️ Répartition des séances</div>
      <div class="card-body">
        <canvas id="workoutTypesChart" height="120"></canvas>
      </div>
    </div>
  </div>
</div>

<!-- Top 5 exercices -->
<div class="row g-3">
  <div class="col-md-8">
    <div class="card shadow-sm">
      <div class="card-header fw-semibold">💪 Top 5 exercices (graphique)</div>
      <div class="card-body">
        <canvas id="topExercisesChart" height="120"></canvas>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card shadow-sm">
      <div class="card-header fw-semibold">💪 Top 5 exercices (plateforme)</div>
      <div class="card-body p-0">
        <table class="table table-sm mb-0">
          <thead class="table-light">
            <tr><th>#</th><th>Exercice</th><th>Occurrences</th></tr>
          </thead>
          <tbody>
            ${topExercises.map((e, i) => `
            <tr>
              <td class="text-muted">${i + 1}</td>
              <td>${e.name}</td>
              <td><span class="badge bg-primary">${e.count}</span></td>
            </tr>`).join('')}
            ${topExercises.length === 0 ? '<tr><td colspan="3" class="text-muted text-center py-3">Aucune donnée</td></tr>' : ''}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>
<script>
  (function () {
    const chartData = {
      inscriptions: {
        labels: ${JSON.stringify(chartData.inscriptions.labels)},
        values: ${JSON.stringify(chartData.inscriptions.values)},
      },
      workoutTypes: {
        labels: ${JSON.stringify(chartData.workoutTypes.labels)},
        values: ${JSON.stringify(chartData.workoutTypes.values)},
      },
      topExercises: {
        labels: ${JSON.stringify(chartData.topExercises.labels)},
        values: ${JSON.stringify(chartData.topExercises.values)},
      },
    };

    new Chart(document.getElementById('inscriptionsChart'), {
      type: 'line',
      data: {
        labels: chartData.inscriptions.labels,
        datasets: [{
          label: 'Inscriptions',
          data: chartData.inscriptions.values,
          borderColor: '#0d6efd',
          backgroundColor: 'rgba(13, 110, 253, 0.18)',
          tension: 0.35,
          fill: true,
          pointRadius: 3,
        }],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: { y: { beginAtZero: true, ticks: { precision: 0 } } },
        plugins: { legend: { display: false } },
      },
    });

    new Chart(document.getElementById('workoutTypesChart'), {
      type: 'doughnut',
      data: {
        labels: chartData.workoutTypes.labels,
        datasets: [{
          data: chartData.workoutTypes.values,
          backgroundColor: ['#198754', '#fd7e14', '#0dcaf0'],
          borderWidth: 0,
        }],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { position: 'bottom' } },
      },
    });

    new Chart(document.getElementById('topExercisesChart'), {
      type: 'bar',
      data: {
        labels: chartData.topExercises.labels,
        datasets: [{
          label: 'Occurrences',
          data: chartData.topExercises.values,
          backgroundColor: '#6f42c1',
          borderRadius: 6,
        }],
      },
      options: {
        indexAxis: 'y',
        responsive: true,
        maintainAspectRatio: false,
        scales: { x: { beginAtZero: true, ticks: { precision: 0 } } },
        plugins: { legend: { display: false } },
      },
    });
  })();
</script>
`;
%>
<%- include('layout', { page, title, body, admin }) %>
