<%
  var page = 'error-reports';
  var title = 'Kanban reports d\'erreur';

  var labels = {
    nouveau: 'Nouveau',
    en_cours: 'En cours',
    traite: 'Traite',
  };

  var badgeClass = {
    dev: 'bg-warning text-dark',
    resolu: 'bg-info text-dark',
    en_prod: 'bg-success',
  };

  var stageLabel = {
    dev: 'dev',
    resolu: 'resolu',
    en_prod: 'en prod',
  };

  var body = `
<div class="d-flex justify-content-between align-items-center mb-3">
  <p class="text-muted mb-0">Vue Kanban des erreurs remontees par les utilisateurs</p>
  <span class="badge bg-dark">${(grouped.nouveau.length + grouped.en_cours.length + grouped.traite.length)} total</span>
</div>

<div class="row g-3">
  ${statusColumns.map(status => `
  <div class="col-md-4">
    <div class="card shadow-sm h-100">
      <div class="card-header d-flex justify-content-between align-items-center">
        <strong>${labels[status]}</strong>
        <span class="badge bg-secondary">${grouped[status].length}</span>
      </div>
      <div class="card-body" style="background:#f6f7fb; max-height:70vh; overflow:auto;">
        ${grouped[status].length === 0 ? '<div class="text-muted small">Aucun report</div>' : ''}
        ${grouped[status].map(r => `
        <div class="card mb-3 border-0 shadow-sm">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <div class="small text-muted">${new Date(r.createdAt).toLocaleString('fr-FR')}</div>
              <span class="badge ${badgeClass[r.workflowStage] || 'bg-secondary'}">${stageLabel[r.workflowStage] || r.workflowStage}</span>
            </div>

            <div class="fw-semibold mb-1">${(r.errorMessage || '').replace(/</g, '&lt;').slice(0, 220)}</div>
            <div class="small text-muted mb-2">Page: ${r.pagePath || '-'}</div>
            <div class="small mb-2">User: <strong>${r.user?.name || 'Inconnu'}</strong> <span class="text-muted">${r.user?.email || ''}</span></div>
            <div class="small mb-3">Responsable: <strong>${r.ownerName || 'Non assigne'}</strong></div>

            <form method="post" action="/admin/error-reports/${r.id}/update" class="row g-2">
              <div class="col-12">
                <select class="form-select form-select-sm" name="status" required>
                  <option value="nouveau" ${r.status === 'nouveau' ? 'selected' : ''}>Nouveau</option>
                  <option value="en_cours" ${r.status === 'en_cours' ? 'selected' : ''}>En cours</option>
                  <option value="traite" ${r.status === 'traite' ? 'selected' : ''}>Traite</option>
                </select>
              </div>
              <div class="col-12">
                <select class="form-select form-select-sm" name="workflowStage" required>
                  <option value="dev" ${r.workflowStage === 'dev' ? 'selected' : ''}>dev</option>
                  <option value="resolu" ${r.workflowStage === 'resolu' ? 'selected' : ''}>resolu</option>
                  <option value="en_prod" ${r.workflowStage === 'en_prod' ? 'selected' : ''}>en prod</option>
                </select>
              </div>
              <div class="col-12">
                <input class="form-control form-control-sm" name="ownerName" value="${(r.ownerName || '').replace(/"/g, '&quot;')}" placeholder="Nom responsable" maxlength="100" />
              </div>
              <div class="col-12 d-grid">
                <button class="btn btn-sm btn-primary" type="submit">Mettre a jour</button>
              </div>
            </form>
          </div>
        </div>`).join('')}
      </div>
    </div>
  </div>`).join('')}
</div>
`;
%>
<%- include('layout', { page, title, body, admin }) %>
