<%
  var page = 'logs';
  var title = 'Journal d\'activité admin';
%>
<%
var paginationHtml = '';
for (var i = 1; i <= totalPages; i++) {
  paginationHtml += `<li class="page-item ${i===page?'active':''}"><a class="page-link" href="/admin/logs?page=${i}">${i}</a></li>`;
}

var body = `
<div class="card shadow-sm">
  <div class="card-body p-0">
    <table class="table table-striped table-sm mb-0">
      <thead class="table-dark"><tr><th>Date</th><th>Action</th><th>Type cible</th><th>Cible</th><th>Détails</th></tr></thead>
      <tbody>
        ${logs.map(l => `
        <tr>
          <td class="text-nowrap">${new Date(l.createdAt).toLocaleString('fr-FR')}</td>
          <td><code>${l.action}</code></td>
          <td>${l.targetType || '—'}</td>
          <td class="text-truncate" style="max-width:120px">${l.targetId || '—'}</td>
          <td><small>${l.payload ? JSON.stringify(l.payload).slice(0, 80) : '—'}</small></td>
        </tr>`).join('')}
      </tbody>
    </table>
  </div>
</div>
<nav class="mt-3">
  <ul class="pagination">${paginationHtml}</ul>
</nav>
<p class="text-muted small">${total} entrée(s)</p>
`;
%>
<%- include('layout', { page, title, body, admin }) %>
