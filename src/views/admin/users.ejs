<%
  var page = 'users';
  var title = 'Utilisateurs';
  var readOnly = typeof adminIsReadOnly !== 'undefined' && adminIsReadOnly;
%>
<%
var paginationHtml = '';
for (var i = 1; i <= totalPages; i++) {
  paginationHtml += `<li class="page-item ${i===page?'active':''}"><a class="page-link" href="/admin/users?page=${i}&q=${search}">${i}</a></li>`;
}

var body = `
<div class="d-flex gap-2 mb-3">
  <form class="d-flex gap-2" method="GET" action="/admin/users">
    <input type="text" name="q" class="form-control" placeholder="Rechercher nom ou email…" value="${search}">
    <button class="btn btn-outline-secondary">Rechercher</button>
  </form>
</div>
<div class="card shadow-sm">
  <div class="card-body p-0">
    <table class="table table-striped table-hover mb-0">
      <thead class="table-dark">
        <tr><th>Nom</th><th>Email</th><th>OAuth</th><th>Inscription</th><th>Séances</th><th>Statut</th><th>Actions</th></tr>
      </thead>
      <tbody>
        ${users.map(u => `
        <tr>
          <td>${u.name}</td>
          <td>${u.email || '—'}</td>
          <td>${u.oauthProviders.map(p => `<span class="badge bg-secondary">${p.provider}</span>`).join(' ')}</td>
          <td>${new Date(u.createdAt).toLocaleDateString('fr-FR')}</td>
          <td>${u._count.workouts}</td>
          <td>${u.isDisabled ? '<span class="badge bg-secondary">Desactive</span>' : (u.isBanned ? '<span class="badge bg-danger">Banni</span>' : '<span class="badge bg-success">Actif</span>')}</td>
          <td class="d-flex gap-1">
            <a href="/admin/users/${u.id}" class="btn btn-sm btn-outline-primary">Voir</a>
            ${readOnly ? '' : `
            <form method="POST" action="/admin/users/${u.id}/ban" class="d-inline">
              <button class="btn btn-sm btn-outline-warning" type="submit">${u.isBanned ? 'Débannir' : 'Bannir'}</button>
            </form>
            ${u.isDisabled ? `
            <form method="POST" action="/admin/users/${u.id}/reactivate" class="d-inline" onsubmit="return confirm('Reactiver cet utilisateur ?')">
              <button class="btn btn-sm btn-outline-success" type="submit">Reactiver</button>
            </form>` : `
            <form method="POST" action="/admin/users/${u.id}/disable" class="d-inline" onsubmit="return confirm('Desactiver temporairement cet utilisateur ?')">
              <button class="btn btn-sm btn-outline-secondary" type="submit">Desact.</button>
            </form>`}
            <form method="POST" action="/admin/users/${u.id}/delete" class="d-inline" onsubmit="return confirm('Desactiver cet utilisateur et planifier sa suppression definitive ?')">
              <button class="btn btn-sm btn-outline-danger" type="submit">Suppr.</button>
            </form>
            `}
          </td>
        </tr>`).join('')}
      </tbody>
    </table>
  </div>
</div>
<nav class="mt-3">
  <ul class="pagination">${paginationHtml}</ul>
</nav>
<p class="text-muted small">${total} utilisateur(s)</p>
`;
%>
<%- include('layout', { page, title, body, admin }) %>
