<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>FitnessPro — Votre compagnon fitness ultime</title>
  <meta name="description" content="FitnessPro — Application mobile tout-en-un pour la musculation, la course GPS, le suivi de pas, de poids et la gamification fitness.">
  <meta name="google-site-verification" content="deUziBWQNmrnH_hnALtVoQN2L4Mn8dB7TJGeORzvj3Y" />
  <style>
    /* ── Variables ─────────────────────────────────────────────── */
    :root {
      --bg:     #0D0D0D;
      --s1:     #1A1A2E;
      --s2:     #16213E;
      --border: #2a2a4a;
      --orange: #FF6B00;
      --orlight:#FF8A3D;
      --ordark: #E55A00;
      --green:  #00D26A;
      --text:   #f0f0f0;
      --muted:  #7a7a9a;
      --r-phone: 38px;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body { background: var(--bg); color: var(--text); font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; overflow-x: hidden; }

    /* ── Progress bar ──────────────────────────────────────────── */
    #progress-bar { position: fixed; top: 0; left: 0; height: 3px; background: linear-gradient(90deg, var(--orange), var(--orlight)); width: 0%; z-index: 9999; transition: width .1s; }

    /* ── Nav ───────────────────────────────────────────────────── */
    nav {
      position: fixed; top: 3px; left: 0; right: 0; z-index: 100;
      display: flex; justify-content: space-between; align-items: center;
      padding: 1rem 2.5rem;
      background: rgba(13,13,13,.7); backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(255,107,0,.08);
      transition: background .3s;
    }
    .nav-brand { font-weight: 900; font-size: 1.3rem; letter-spacing: -.5px; color: #fff; text-decoration: none; }
    .nav-brand span { background: linear-gradient(135deg, var(--orange), var(--orlight)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
    .nav-links { display: flex; align-items: center; gap: 2rem; }
    .nav-links a { color: var(--muted); text-decoration: none; font-size: .9rem; transition: color .2s; }
    .nav-links a:hover { color: #fff; }
    .nav-cta { background: rgba(255,107,0,.12); border: 1px solid rgba(255,107,0,.4); color: var(--orlight) !important; padding: .45rem 1.2rem; border-radius: 8px; font-weight: 600; transition: background .2s, transform .15s !important; }
    .nav-cta:hover { background: rgba(255,107,0,.25) !important; transform: translateY(-1px); }

    /* ── Hero ──────────────────────────────────────────────────── */
    .hero {
      min-height: 100vh;
      display: flex; align-items: center;
      padding: 8rem 2.5rem 5rem;
      position: relative; overflow: hidden;
    }
    .hero-content { flex: 1; max-width: 560px; z-index: 2; }
    .hero-phone-wrap { flex: 1; display: flex; justify-content: center; align-items: center; z-index: 2; }

    .orb { position: absolute; border-radius: 50%; filter: blur(80px); pointer-events: none; }
    .orb-1 { width: 600px; height: 600px; background: rgba(255,107,0,.12); top: -150px; right: -150px; }
    .orb-2 { width: 400px; height: 400px; background: rgba(255,107,0,.07); bottom: -100px; left: 10%; }

    .hero-badge {
      display: inline-flex; align-items: center; gap: .4rem;
      background: rgba(255,107,0,.1); border: 1px solid rgba(255,107,0,.25);
      color: var(--orlight); border-radius: 50px; padding: .35rem 1rem;
      font-size: .8rem; font-weight: 600; letter-spacing: .3px;
      margin-bottom: 1.5rem;
      animation: fadeDown .6s ease both;
    }
    .hero-badge .dot { width: 7px; height: 7px; background: var(--orange); border-radius: 50%; animation: pulse 2s infinite; }

    .hero h1 {
      font-size: clamp(2.8rem, 5.5vw, 4.5rem);
      font-weight: 900; line-height: 1.05; letter-spacing: -2px;
      color: #fff; margin-bottom: 1.25rem;
      animation: fadeUp .7s ease .1s both;
    }
    .hero h1 .grad { background: linear-gradient(135deg, var(--orange) 0%, var(--orlight) 60%, #FFD27A 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
    .hero p { color: var(--muted); font-size: 1.1rem; line-height: 1.75; max-width: 460px; margin-bottom: 2.25rem; animation: fadeUp .7s ease .2s both; }

    .hero-btns { display: flex; gap: 1rem; flex-wrap: wrap; animation: fadeUp .7s ease .3s both; }
    .btn-store {
      display: inline-flex; align-items: center; gap: .75rem;
      padding: .85rem 1.6rem; border-radius: 14px;
      font-weight: 700; font-size: .95rem; text-decoration: none;
      transition: transform .2s, box-shadow .2s;
    }
    .btn-store:hover { transform: translateY(-3px); }
    .btn-store-dark { background: #fff; color: #000; box-shadow: 0 8px 30px rgba(255,255,255,.1); }
    .btn-store-dark:hover { box-shadow: 0 12px 40px rgba(255,255,255,.2); }
    .btn-store-orange { background: linear-gradient(135deg, var(--orange), var(--ordark)); color: #fff; box-shadow: 0 8px 30px rgba(255,107,0,.3); }
    .btn-store-orange:hover { box-shadow: 0 12px 40px rgba(255,107,0,.5); }
    .btn-store svg { width: 22px; height: 22px; flex-shrink: 0; }
    .btn-store .btn-sub { font-size: .7rem; font-weight: 400; opacity: .7; display: block; }
    .btn-store .btn-main { font-size: .95rem; font-weight: 700; display: block; }

    .scroll-hint { position: absolute; bottom: 2.5rem; left: 50%; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; gap: .3rem; color: var(--muted); font-size: .75rem; animation: fadeUp 1s ease .8s both; }
    .scroll-hint span { width: 1px; height: 40px; background: linear-gradient(to bottom, var(--orange), transparent); animation: scrollLine 2s ease-in-out infinite; }

    /* ── Phone frame ───────────────────────────────────────────── */
    .phone-frame {
      width: 260px;
      border-radius: 48px;
      background: #060610;
      overflow: hidden;
      position: relative;
      flex-shrink: 0;
      /* Bezel multi-couche : simule le corps du téléphone */
      box-shadow:
        0 0 0 2px #1e1e32,
        0 0 0 5px #14142a,
        0 0 0 7px #252542,
        0 0 0 8px rgba(255,255,255,.04),
        0 60px 130px rgba(0,0,0,.9),
        0 0 80px rgba(255,107,0,.18);
    }
    .phone-frame.hero-phone {
      width: 285px;
      transform: rotate(-6deg) translateY(-20px);
      animation: phonePulse 4s ease-in-out infinite, fadeUp .9s ease .4s both;
    }
    .phone-frame.hero-phone-2 {
      width: 245px;
      transform: rotate(4deg) translateY(30px) translateX(-30px);
      animation: phonePulse2 4s ease-in-out infinite, fadeUp .9s ease .55s both;
      box-shadow:
        0 0 0 2px #1e1e32,
        0 0 0 5px #14142a,
        0 0 0 7px #252542,
        0 0 0 8px rgba(255,255,255,.03),
        0 40px 100px rgba(0,0,0,.85),
        0 0 50px rgba(255,107,0,.1);
    }
    /* Dynamic Island */
    .phone-frame::before {
      content: '';
      position: absolute; top: 11px; left: 50%; transform: translateX(-50%);
      width: 90px; height: 24px;
      background: #000;
      border-radius: 14px;
      z-index: 20;
      box-shadow: 0 0 0 1px rgba(255,255,255,.06), inset 0 1px 4px rgba(0,0,0,.9);
    }
    /* Home indicator */
    .phone-frame::after {
      content: '';
      position: absolute; bottom: 7px; left: 50%; transform: translateX(-50%);
      width: 100px; height: 4px;
      background: rgba(255,255,255,.22);
      border-radius: 2px;
      z-index: 20;
    }
    /* Reflet écran */
    .phone-frame img {
      width: 100%; display: block;
      position: relative; z-index: 1;
    }
    .phone-frame .screen-glare {
      position: absolute; inset: 0; z-index: 5; pointer-events: none;
      background: linear-gradient(135deg, rgba(255,255,255,.06) 0%, rgba(255,255,255,.01) 40%, transparent 60%);
      border-radius: 48px;
    }

    .phones-group { display: flex; justify-content: center; align-items: flex-end; gap: 0; position: relative; }

    /* ── Stats bar ─────────────────────────────────────────────── */
    .stats-bar {
      background: var(--s1);
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      padding: 2.5rem 2.5rem;
    }
    .stats-inner { max-width: 900px; margin: 0 auto; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; text-align: center; }
    .stat-item { padding: 1rem; }
    .stat-num { font-size: 2.5rem; font-weight: 900; background: linear-gradient(135deg, var(--orange), var(--orlight)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; line-height: 1; }
    .stat-label { color: var(--muted); font-size: .85rem; margin-top: .4rem; }

    /* ── Sections génériques ───────────────────────────────────── */
    .section { padding: 6rem 2.5rem; max-width: 1100px; margin: 0 auto; }
    .section-alt { background: linear-gradient(to bottom, transparent, var(--s1) 20%, var(--s1) 80%, transparent); }

    .feat-row {
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 5rem; align-items: center; margin-bottom: 7rem;
    }
    .feat-row:last-child { margin-bottom: 0; }
    .feat-row.reverse { direction: rtl; }
    .feat-row.reverse > * { direction: ltr; }

    .feat-tag { display: inline-block; background: rgba(255,107,0,.1); border: 1px solid rgba(255,107,0,.2); color: var(--orlight); border-radius: 6px; padding: .2rem .7rem; font-size: .75rem; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; margin-bottom: 1rem; }
    .feat-title { font-size: 2rem; font-weight: 800; color: #fff; letter-spacing: -.5px; margin-bottom: 1rem; line-height: 1.2; }
    .feat-desc { color: var(--muted); font-size: .975rem; line-height: 1.8; margin-bottom: 1.5rem; }
    .feat-pills { display: flex; flex-wrap: wrap; gap: .5rem; }
    .pill { background: var(--s2); border: 1px solid var(--border); color: var(--text); border-radius: 8px; padding: .35rem .85rem; font-size: .825rem; display: inline-flex; align-items: center; gap: .35rem; }
    .pill .dot-g { width: 6px; height: 6px; background: var(--green); border-radius: 50%; }
    .pill .dot-o { width: 6px; height: 6px; background: var(--orange); border-radius: 50%; }

    .phone-duo { position: relative; display: flex; justify-content: center; height: 520px; }
    .phone-duo .phone-frame.main { position: absolute; left: 50%; transform: translateX(-60%); z-index: 2; }
    .phone-duo .phone-frame.secondary { position: absolute; left: 50%; transform: translateX(10%) translateY(40px) rotate(6deg); z-index: 1; width: 220px; opacity: .85; }

    /* ── Badges section ────────────────────────────────────────── */
    .badges-section { padding: 6rem 2.5rem; text-align: center; position: relative; overflow: hidden; }
    .badges-section .orb-b { position: absolute; width: 500px; height: 500px; background: rgba(255,184,0,.06); border-radius: 50%; filter: blur(80px); top: 50%; left: 50%; transform: translate(-50%,-50%); pointer-events: none; }
    .section-label { font-size: .8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: var(--orange); margin-bottom: .75rem; }
    .section-title { font-size: clamp(2rem, 4vw, 3rem); font-weight: 900; color: #fff; letter-spacing: -1px; margin-bottom: 1rem; }
    .section-sub { color: var(--muted); font-size: 1rem; max-width: 500px; margin: 0 auto 3rem; line-height: 1.7; }

    .badge-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; max-width: 700px; margin: 0 auto 3rem; }
    .badge-card { background: var(--s1); border: 1px solid var(--border); border-radius: 14px; padding: 1.25rem 1rem; text-align: center; transition: border-color .2s, transform .2s; }
    .badge-card:hover { border-color: rgba(255,184,0,.4); transform: translateY(-3px); }
    .badge-card .icon { font-size: 2rem; margin-bottom: .5rem; }
    .badge-card h4 { color: #fff; font-size: .875rem; font-weight: 700; margin-bottom: .25rem; }
    .badge-card p { color: var(--muted); font-size: .775rem; line-height: 1.5; }

    .badges-phone { display: flex; justify-content: center; }

    /* ── Arguments ─────────────────────────────────────────────── */
    .args-section { padding: 6rem 2.5rem; }
    .args-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; max-width: 1000px; margin: 3rem auto 0; }
    .arg-card {
      background: var(--s1); border: 1px solid var(--border); border-radius: 16px;
      padding: 1.75rem 1.5rem;
      transition: border-color .3s, transform .2s, box-shadow .3s;
      cursor: default;
    }
    .arg-card:hover { border-color: rgba(255,107,0,.35); transform: translateY(-4px) scale(1.01); box-shadow: 0 20px 60px rgba(255,107,0,.08); }
    .arg-icon { font-size: 1.75rem; margin-bottom: 1rem; }
    .arg-card h3 { color: #fff; font-size: .975rem; font-weight: 700; margin-bottom: .5rem; }
    .arg-card p { color: var(--muted); font-size: .85rem; line-height: 1.65; }

    /* ── CTA final ─────────────────────────────────────────────── */
    .cta-section { padding: 6rem 2.5rem; text-align: center; position: relative; overflow: hidden; }
    .cta-inner { background: linear-gradient(135deg, #1a0a00, #2d1200, #1a0a00); border: 1px solid rgba(255,107,0,.25); border-radius: 24px; padding: 5rem 2rem; max-width: 800px; margin: 0 auto; position: relative; overflow: hidden; }
    .cta-inner::before { content: ''; position: absolute; top: -100px; left: 50%; transform: translateX(-50%); width: 400px; height: 400px; background: radial-gradient(circle, rgba(255,107,0,.15) 0%, transparent 70%); pointer-events: none; }
    .cta-title { font-size: clamp(2rem, 4vw, 3rem); font-weight: 900; color: #fff; letter-spacing: -1px; margin-bottom: 1rem; }
    .cta-sub { color: rgba(255,255,255,.6); font-size: 1.05rem; margin-bottom: 2.5rem; }
    .cta-btns { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; }

    /* ── Footer ────────────────────────────────────────────────── */
    footer { border-top: 1px solid var(--border); padding: 3rem 2.5rem 2rem; }
    .footer-inner { max-width: 900px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.5rem; }
    .footer-brand { font-weight: 900; font-size: 1.2rem; color: #fff; letter-spacing: -.5px; }
    .footer-brand span { background: linear-gradient(135deg, var(--orange), var(--orlight)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
    .footer-links { display: flex; gap: 1.5rem; flex-wrap: wrap; }
    .footer-links a { color: var(--muted); text-decoration: none; font-size: .85rem; transition: color .2s; }
    .footer-links a:hover { color: var(--orlight); }
    .footer-copy { max-width: 900px; margin: 1.5rem auto 0; color: var(--muted); font-size: .8rem; text-align: center; }

    /* ── Animations ────────────────────────────────────────────── */
    @keyframes fadeUp   { from { opacity:0; transform: translateY(24px); } to { opacity:1; transform: translateY(0); } }
    @keyframes fadeDown { from { opacity:0; transform: translateY(-14px); } to { opacity:1; transform: translateY(0); } }
    @keyframes pulse    { 0%,100% { transform: scale(1); opacity:1; } 50% { transform: scale(1.4); opacity:.6; } }
    @keyframes scrollLine { 0%,100% { transform: scaleY(1); opacity:.7; } 50% { transform: scaleY(.5); opacity:.3; } }
    @keyframes phonePulse  { 0%,100% { box-shadow: 0 0 60px rgba(255,107,0,.2), 0 40px 100px rgba(0,0,0,.8); } 50% { box-shadow: 0 0 100px rgba(255,107,0,.35), 0 40px 100px rgba(0,0,0,.8); } }
    @keyframes phonePulse2 { 0%,100% { box-shadow: 0 0 40px rgba(255,107,0,.1), 0 30px 80px rgba(0,0,0,.7); } 50% { box-shadow: 0 0 70px rgba(255,107,0,.2), 0 30px 80px rgba(0,0,0,.7); } }

    .reveal { opacity: 0; transform: translateY(30px); transition: opacity .7s ease, transform .7s ease; }
    .reveal.visible { opacity: 1; transform: translateY(0); }
    .reveal-left { opacity: 0; transform: translateX(-40px); transition: opacity .7s ease, transform .7s ease; }
    .reveal-left.visible { opacity: 1; transform: translateX(0); }
    .reveal-right { opacity: 0; transform: translateX(40px); transition: opacity .7s ease, transform .7s ease; }
    .reveal-right.visible { opacity: 1; transform: translateX(0); }

    /* ── Responsive ────────────────────────────────────────────── */
    @media (max-width: 900px) {
      .hero { flex-direction: column; padding-top: 7rem; text-align: center; }
      .hero p { margin-left: auto; margin-right: auto; }
      .hero-btns { justify-content: center; }
      .feat-row { grid-template-columns: 1fr; gap: 3rem; }
      .feat-row.reverse { direction: ltr; }
      .stats-inner { grid-template-columns: repeat(2,1fr); }
      .badge-grid { grid-template-columns: repeat(2,1fr); }
      .args-grid { grid-template-columns: repeat(2,1fr); }
      .nav-links .hide-mobile { display: none; }
    }
    @media (max-width: 600px) {
      nav { padding: .9rem 1.2rem; }
      .args-grid { grid-template-columns: 1fr; }
      .badge-grid { grid-template-columns: repeat(2,1fr); }
      .footer-inner { flex-direction: column; text-align: center; }
    }
  </style>
</head>
<body>

<!-- Progress bar -->
<div id="progress-bar"></div>

<!-- ── Nav ──────────────────────────────────────────────────────── -->
<nav id="navbar">
  <a href="/" class="nav-brand"><span>Fitness</span>Pro</a>
  <div class="nav-links">
    <a href="#features" class="hide-mobile">Fonctionnalités</a>
    <a href="#badges" class="hide-mobile">Badges</a>
    <a href="#social" class="hide-mobile">Social</a>
    <a href="#download" class="nav-cta">Télécharger</a>
  </div>
</nav>

<!-- ── Hero ─────────────────────────────────────────────────────── -->
<section class="hero">
  <div class="orb orb-1"></div>
  <div class="orb orb-2"></div>

  <div class="hero-content">
    <div class="hero-badge">
      <div class="dot"></div>
      v1.0.1 · Android &amp; iOS
    </div>
    <h1>Votre compagnon<br><span class="grad">fitness ultime</span></h1>
    <p>Musculation, course GPS, pas quotidiens, suivi du poids et gamification — tout en une seule application, optimisée pour Basic-Fit.</p>
    <div class="hero-btns">
      <a href="#download" class="btn-store btn-store-dark">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
        <div><span class="btn-sub">Télécharger sur</span><span class="btn-main">App Store</span></div>
      </a>
      <a href="/fitnesspro.apk" download class="btn-store btn-store-orange">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M3.18 23.76c.3.17.64.24.99.2l12.43-12.43L13 8l-9.82 15.76zM20.7 10.37l-2.87-1.62-3.27 3.27 3.27 3.27 2.9-1.64c.83-.47.83-1.81-.03-2.28zM2.13 1.28C2.05 1.5 2 1.75 2 2.04v19.92c0 .28.04.53.13.75L14.56 10 2.13 1.28zM16.31 5.65L3.88.2c-.35-.04-.69.03-.99.2L16.31 13.6 19.58 10 16.31 5.65z"/></svg>
        <div><span class="btn-sub">Télécharger l'</span><span class="btn-main">APK Android</span></div>
      </a>
    </div>
  </div>

  <div class="hero-phone-wrap">
    <div class="phones-group">
      <div class="phone-frame hero-phone">
        <div class="screen-glare"></div>
        <img src="/image/pA.png" alt="Dashboard FitnessPro">
      </div>
      <div class="phone-frame hero-phone-2">
        <div class="screen-glare"></div>
        <img src="/image/entrainementA.png" alt="Entraînements FitnessPro">
      </div>
    </div>
  </div>

  <div class="scroll-hint">Défiler<span></span></div>
</section>

<!-- ── Stats bar ─────────────────────────────────────────────────── -->
<div class="stats-bar reveal">
  <div class="stats-inner">
    <div class="stat-item">
      <div class="stat-num" data-target="48">0</div>
      <div class="stat-label">Badges à débloquer</div>
    </div>
    <div class="stat-item">
      <div class="stat-num" data-target="50">0</div>
      <div class="stat-label">Exercices préconfigurés</div>
    </div>
    <div class="stat-item">
      <div class="stat-num" data-target="5">0</div>
      <div class="stat-label">Programmes inclus</div>
    </div>
    <div class="stat-item">
      <div class="stat-num" data-target="3">0</div>
      <div class="stat-label">Modes de course GPS</div>
    </div>
  </div>
</div>

<!-- ── Features ─────────────────────────────────────────────────── -->
<div id="features">

  <!-- Musculation -->
  <div class="section">
    <div class="feat-row">
      <div class="reveal-left">
        <span class="feat-tag">💪 Musculation</span>
        <h2 class="feat-title">Entraînez-vous comme un pro</h2>
        <p class="feat-desc">Bibliothèque de 50+ exercices adaptés aux machines Basic-Fit, 5 programmes prêts à l'emploi du débutant au confirmé. Suivez chaque série en temps réel.</p>
        <div class="feat-pills">
          <span class="pill"><span class="dot-o"></span>5 programmes inclus</span>
          <span class="pill"><span class="dot-o"></span>50+ exercices</span>
          <span class="pill"><span class="dot-g"></span>Suivi en direct</span>
          <span class="pill"><span class="dot-g"></span>Optimisé Basic-Fit</span>
        </div>
