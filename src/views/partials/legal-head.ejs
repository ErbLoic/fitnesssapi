  <link rel="icon" href="/app_icon.svg" type="image/svg+xml">
  <style>
    :root {
      --bg: #08090c;
      --surface: #11151c;
      --surface-soft: #171d28;
      --line: rgba(255,255,255,.12);
      --text: #f8fafc;
      --muted: #a6b0c0;
      --orange: #ff6b00;
      --orange-2: #ff9c42;
      --green: #28d17c;
      --radius: 8px;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      min-height: 100vh;
      background:
        linear-gradient(120deg, rgba(255,107,0,.12), transparent 32%),
        #08090c;
      color: var(--text);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    a { color: inherit; }
    .legal-nav {
