      font-size: clamp(2.2rem, 5vw, 4.2rem);
      line-height: 1;
      letter-spacing: 0;
      font-weight: 950;
    }
    .updated {
      margin-top: 1rem;
      color: var(--muted);
      font-size: .92rem;
    }
    .legal-content {
      padding: clamp(1.4rem, 4vw, 3rem);
    }
    .intro {
