    .warning-box p { color: #fecaca; margin: 0; }
    .info-box { border-color: rgba(64,199,232,.32); background: rgba(64,199,232,.08); }
    .info-box p { color: #bfebf7; margin: 0; }
    .steps {
      counter-reset: step;
      list-style: none;
      padding: 0 !important;
      display: grid;
      gap: .9rem;
    }
    .steps li {
      counter-increment: step;
      display: grid;
      grid-template-columns: 42px 1fr;
      gap: .9rem;
      margin: 0;
    }
    .steps li::before {
      content: counter(step);
      width: 42px;
      height: 42px;
      display: grid;
      place-items: center;
      border-radius: var(--radius);
      color: #15181e;
      background: var(--orange-2);
      font-weight: 950;
    }
    .step-content strong { display: block; margin-bottom: .2rem; }
    .legal-footer {
      border-top: 1px solid var(--line);
      padding: 2.2rem 0;
      background: #07080b;
    }
    .legal-footer-inner,
    .legal-copy {
      width: min(1080px, calc(100% - 32px));
      margin: 0 auto;
    }
    .legal-footer-inner {
      display: flex;
      justify-content: space-between;
      gap: 1.2rem;
      flex-wrap: wrap;
      align-items: center;
    }
    .legal-footer-links {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .legal-footer-links a {
      color: var(--muted);
      text-decoration: none;
      font-size: .88rem;
      font-weight: 750;
    }
    .legal-copy {
      margin-top: 1rem;
      color: #738095;
      font-size: .82rem;
    }
    @media (max-width: 860px) {
      .legal-shell { grid-template-columns: 1fr; padding-top: 36px; }
      .legal-aside { position: relative; top: auto; }
      .legal-nav-inner { align-items: flex-start; flex-direction: column; padding: .85rem 0; }
    }
  </style>
