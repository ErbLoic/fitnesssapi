      border-bottom: 1px solid var(--line);
      background: rgba(8,9,12,.78);
      backdrop-filter: blur(18px);
    }
    .legal-nav-inner {
      width: min(1080px, calc(100% - 32px));
      min-height: 72px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }
    .brand {
      display: inline-flex;
      align-items: center;
      gap: .7rem;
      color: #fff;
      text-decoration: none;
      font-weight: 900;
    }
    .brand img {
      width: 38px;
      height: 38px;
      border-radius: var(--radius);
      box-shadow: 0 14px 34px rgba(255,107,0,.3);
    }
    .legal-links {
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .legal-links a {
      color: var(--muted);
      text-decoration: none;
      font-size: .88rem;
      font-weight: 750;
    }
    .legal-links a:hover { color: #fff; }
    .legal-shell {
      width: min(1080px, calc(100% - 32px));
      margin: 0 auto;
      padding: 66px 0 92px;
      display: grid;
      grid-template-columns: 280px minmax(0, 1fr);
      gap: 2rem;
      align-items: start;
    }
    .legal-aside {
      position: sticky;
      top: 104px;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: rgba(17,21,28,.78);
